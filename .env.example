# Used only by domain_assistant.py when generating real RAG answers.
# Copy this file to .env, choose a provider, then replace the placeholder key.
# Gemini is the default provider for this lab run.
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Optional compatibility fallback when AI_PROVIDER=openai.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
